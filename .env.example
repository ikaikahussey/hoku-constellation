# ---------------------------------------------------------------- Neon (Postgres)
# Pooled connection string (PgBouncer) — Vercel functions, Data API-free server reads.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection — migrations, pg_dump/pg_restore, workers, port script.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Driver override for lib/db/service.ts: pg (default off Vercel) | neon (default on Vercel)
# HOKU_DB_DRIVER=pg

# ---------------------------------------------------------------- Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=change-me-to-32-plus-random-characters-openssl-rand-base64-32
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Neon Data API (PostgREST-compatible, RLS enforced by the session JWT)
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxx.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# ---------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=https://constellation.hoku.fm
CRON_SECRET=change-me

